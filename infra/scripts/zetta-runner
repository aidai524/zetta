#!/usr/bin/env bash
set -euo pipefail

MODE="${1:?mode is required}"

source /etc/zetta/zetta.env

cd "$ZETTA_HOME"

COMMON_ARGS=(
  --env "${ZETTA_ENV:-stg}"
  --serving-mode "${ZETTA_SERVING_MODE:-compute}"
  --postgres-dsn "$ZETTA_POSTGRES_DSN"
  --clickhouse-host "$ZETTA_CLICKHOUSE_HOST"
  --clickhouse-port "$ZETTA_CLICKHOUSE_PORT"
  --clickhouse-user "$ZETTA_CLICKHOUSE_USER"
  --clickhouse-password "$ZETTA_CLICKHOUSE_PASSWORD"
  --clickhouse-database "$ZETTA_CLICKHOUSE_DATABASE"
  --polygon-rpc-url "$ZETTA_POLYGON_RPC_URL"
  --raw-data-dir "$ZETTA_RAW_DIR"
  --state-dir "$ZETTA_STATE_DIR"
  --publish-data-dir "${ZETTA_PUBLISH_DATA_DIR:-/var/lib/zetta/publish}"
  --raw-chunk-records "${ZETTA_RAW_CHUNK_RECORDS:-1}"
  --raw-chunk-seconds "${ZETTA_RAW_CHUNK_SECONDS:-60}"
)

if [[ "${ZETTA_DISABLE_HEAVY_JOBS:-0}" =~ ^(1|true|yes|on)$ ]]; then
  COMMON_ARGS+=(--disable-heavy-jobs)
else
  COMMON_ARGS+=(--no-disable-heavy-jobs)
fi

if [[ "${ZETTA_ENABLE_CLICKHOUSE_HEAVY_QUERIES:-1}" =~ ^(1|true|yes|on)$ ]]; then
  COMMON_ARGS+=(--enable-clickhouse-heavy-queries)
else
  COMMON_ARGS+=(--no-enable-clickhouse-heavy-queries)
fi

if [[ -n "${ZETTA_HTTP_RESOLVE_OVERRIDES:-}" ]]; then
  COMMON_ARGS+=(--http-resolve-overrides "$ZETTA_HTTP_RESOLVE_OVERRIDES")
fi

case "$MODE" in
  worker)
    WORKER_PROCESSES="${ZETTA_WORKER_PROCESSES:-1}"
    WORKER_TASK_KIND_ARGS=()
    if [[ -n "${ZETTA_WORKER_TASK_KINDS:-}" ]]; then
      IFS=',' read -r -a WORKER_TASK_KINDS <<< "$ZETTA_WORKER_TASK_KINDS"
      for task_kind in "${WORKER_TASK_KINDS[@]}"; do
        task_kind="${task_kind//[[:space:]]/}"
        if [[ -n "$task_kind" ]]; then
          WORKER_TASK_KIND_ARGS+=(--task-kind "$task_kind")
        fi
      done
    fi
    if [[ "$WORKER_PROCESSES" -le 1 ]]; then
      exec "$ZETTA_PYTHON" -m zetta.cli \
        "${COMMON_ARGS[@]}" \
        --task-store postgres \
        --node-id "$ZETTA_NODE_ID" \
        tasks run-loop \
          "${WORKER_TASK_KIND_ARGS[@]}" \
          --idle-sleep-seconds "$ZETTA_WORKER_IDLE_SECONDS"
    fi
    pids=()
    stop_workers() {
      for pid in "${pids[@]}"; do
        kill "$pid" 2>/dev/null || true
      done
      wait || true
    }
    trap stop_workers TERM INT
    for index in $(seq 1 "$WORKER_PROCESSES"); do
      "$ZETTA_PYTHON" -m zetta.cli \
        "${COMMON_ARGS[@]}" \
        --task-store postgres \
        --node-id "${ZETTA_NODE_ID}-${index}" \
        tasks run-loop \
          "${WORKER_TASK_KIND_ARGS[@]}" \
          --idle-sleep-seconds "$ZETTA_WORKER_IDLE_SECONDS" &
      pids+=("$!")
    done
    wait -n
    status="$?"
    stop_workers
    exit "$status"
    ;;
  api)
    exec "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      api serve --host 0.0.0.0 --port 8088
    ;;
  trade-stream)
    exec "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      realtime trade-stream \
        --host 0.0.0.0 \
        --port "${ZETTA_TRADE_STREAM_PORT:-8090}" \
        --poll-seconds "${ZETTA_TRADE_STREAM_POLL_SECONDS:-2}" \
        --limit "${ZETTA_TRADE_STREAM_LIMIT:-150}" \
        --heartbeat-seconds "${ZETTA_TRADE_STREAM_HEARTBEAT_SECONDS:-20}"
    ;;
  official-trade-feed)
    exec "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      realtime official-trade-feed \
        --host 0.0.0.0 \
        --port "${ZETTA_OFFICIAL_TRADE_FEED_PORT:-8091}" \
        --upstream-url "${ZETTA_POLYMARKET_RTDS_URL:-wss://ws-live-data.polymarket.com}"
    ;;
  ws-market)
    exec "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      collect ws-market \
        --active-only \
        --limit "$ZETTA_WS_TOKEN_LIMIT" \
        --max-messages "$ZETTA_WS_MAX_MESSAGES" \
        --max-seconds "$ZETTA_WS_MAX_SECONDS"
    ;;
  frontier)
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-frontier \
        --event-limit "${ZETTA_FRONTIER_EVENT_LIMIT:-50}" \
        --condition-limit "${ZETTA_FRONTIER_CONDITION_LIMIT:-50}" \
        --token-limit "${ZETTA_FRONTIER_TOKEN_LIMIT:-100}" \
        --gamma-page-limit "${ZETTA_FRONTIER_GAMMA_PAGE_LIMIT:-100}" \
        --gamma-max-pages "${ZETTA_FRONTIER_GAMMA_MAX_PAGES:-1}" \
        --trade-page-limit "${ZETTA_FRONTIER_TRADE_PAGE_LIMIT:-500}" \
        --trade-max-pages "${ZETTA_FRONTIER_TRADE_MAX_PAGES:-1}" \
        --price-interval "${ZETTA_FRONTIER_PRICE_INTERVAL:-1d}"
    ;;
  frontier-trades)
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-frontier \
        --sync-mode typed \
        --no-include-gamma \
        --include-trades \
        --include-global-trades \
        --no-include-price-history \
        --no-include-books \
        --refresh-run realtime-trades \
        --requeue-done \
        --event-limit "${ZETTA_TRADES_FRONTIER_EVENT_LIMIT:-50}" \
        --condition-limit "${ZETTA_TRADES_FRONTIER_CONDITION_LIMIT:-100}" \
        --token-limit 0 \
        --trade-page-limit "${ZETTA_TRADES_FRONTIER_TRADE_PAGE_LIMIT:-500}" \
        --trade-max-pages "${ZETTA_TRADES_FRONTIER_TRADE_MAX_PAGES:-1}"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" collect trades \
      --page-limit "${ZETTA_GLOBAL_TRADE_PAGE_LIMIT:-500}" \
      --max-pages "${ZETTA_GLOBAL_TRADE_MAX_PAGES:-1}"
    ;;
  wallets)
    WALLET_ARGS=()
    if [[ -n "${ZETTA_WALLET_WATCHLIST:-}" ]]; then
      IFS=',' read -r -a WATCHED_WALLETS <<< "$ZETTA_WALLET_WATCHLIST"
      for wallet in "${WATCHED_WALLETS[@]}"; do
        wallet="${wallet//[[:space:]]/}"
        if [[ -n "$wallet" ]]; then
          WALLET_ARGS+=(--wallet "$wallet")
        fi
      done
    fi
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-wallets \
        "${WALLET_ARGS[@]}" \
        --wallet-limit "${ZETTA_WALLET_REFRESH_LIMIT:-100}" \
        --since-hours "${ZETTA_WALLET_REFRESH_SINCE_HOURS:-48}" \
        --page-limit "${ZETTA_WALLET_REFRESH_PAGE_LIMIT:-500}" \
        --max-pages "${ZETTA_WALLET_REFRESH_MAX_PAGES:-2}" \
        --candidate-mode "${ZETTA_WALLET_REFRESH_CANDIDATE_MODE:-recent}" \
        --min-notional "${ZETTA_WALLET_REFRESH_MIN_NOTIONAL:-10000}" \
        --include-trades \
        --include-activity \
        --include-wallet-portfolio \
        --include-wallet-pnl \
        --refresh-run realtime-wallets \
        --requeue-done
    ;;
  active-event-wallets)
    WALLET_ARGS=()
    if [[ -n "${ZETTA_WALLET_WATCHLIST:-}" ]]; then
      IFS=',' read -r -a WATCHED_WALLETS <<< "$ZETTA_WALLET_WATCHLIST"
      for wallet in "${WATCHED_WALLETS[@]}"; do
        wallet="${wallet//[[:space:]]/}"
        if [[ -n "$wallet" ]]; then
          WALLET_ARGS+=(--wallet "$wallet")
        fi
      done
    fi
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-active-event-wallets \
        "${WALLET_ARGS[@]}" \
        --event-limit "${ZETTA_ACTIVE_EVENT_WALLET_EVENT_LIMIT:-0}" \
        --condition-limit "${ZETTA_ACTIVE_EVENT_WALLET_CONDITION_LIMIT:-1000}" \
        --wallet-limit "${ZETTA_ACTIVE_EVENT_WALLET_LIMIT:-1000}" \
        --since-minutes "${ZETTA_ACTIVE_EVENT_WALLET_SINCE_MINUTES:-120}" \
        --min-notional "${ZETTA_ACTIVE_EVENT_WALLET_MIN_NOTIONAL:-0}" \
        --trade-page-limit "${ZETTA_ACTIVE_EVENT_TRADE_PAGE_LIMIT:-500}" \
        --trade-max-pages "${ZETTA_ACTIVE_EVENT_TRADE_MAX_PAGES:-1}" \
        --wallet-page-limit "${ZETTA_ACTIVE_EVENT_WALLET_PAGE_LIMIT:-500}" \
        --wallet-max-pages "${ZETTA_ACTIVE_EVENT_WALLET_MAX_PAGES:-1}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_MARKET_TRADES:-include-market-trades}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_WALLET_TRADES:-include-wallet-trades}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_WALLET_ACTIVITY:-include-wallet-activity}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_WALLET_PORTFOLIO:-include-wallet-portfolio}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_WALLET_PNL:-include-wallet-pnl}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_REALTIME_WALLETS:-include-realtime-wallets}" \
        --realtime-wallet-limit "${ZETTA_ACTIVE_EVENT_REALTIME_WALLET_LIMIT:-100}" \
        --realtime-wallet-since-minutes "${ZETTA_ACTIVE_EVENT_REALTIME_WALLET_SINCE_MINUTES:-360}" \
        --realtime-wallet-scan-limit "${ZETTA_ACTIVE_EVENT_REALTIME_WALLET_SCAN_LIMIT:-5000}" \
        --realtime-wallet-min-notional "${ZETTA_ACTIVE_EVENT_REALTIME_WALLET_MIN_NOTIONAL:-0}" \
        "--${ZETTA_ACTIVE_EVENT_INCLUDE_UNUSUAL_BETTING_REFRESH:-no-include-unusual-betting-refresh}" \
        --unusual-betting-event-limit "${ZETTA_ACTIVE_EVENT_UNUSUAL_BETTING_EVENT_LIMIT:-20}" \
        --unusual-betting-min-notional "${ZETTA_ACTIVE_EVENT_UNUSUAL_BETTING_MIN_NOTIONAL:-500000}" \
        --refresh-run "${ZETTA_ACTIVE_EVENT_WALLET_REFRESH_RUN:-active-event-wallets}" \
        --requeue-done
    ;;
  unusual-betting)
    EVENT_ARGS=()
    if [[ -n "${ZETTA_UNUSUAL_BETTING_EVENT_SLUGS:-}" ]]; then
      IFS=',' read -r -a UNUSUAL_BETTING_EVENTS <<< "$ZETTA_UNUSUAL_BETTING_EVENT_SLUGS"
      for event_slug in "${UNUSUAL_BETTING_EVENTS[@]}"; do
        event_slug="${event_slug//[[:space:]]/}"
        if [[ -n "$event_slug" ]]; then
          EVENT_ARGS+=(--event "$event_slug")
        fi
      done
    fi
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-unusual-betting \
        "${EVENT_ARGS[@]}" \
        --event-limit "${ZETTA_UNUSUAL_BETTING_EVENT_LIMIT:-20}" \
        --recent-limit "${ZETTA_UNUSUAL_BETTING_RECENT_LIMIT:-20}" \
        --since-minutes "${ZETTA_UNUSUAL_BETTING_SINCE_MINUTES:-30}" \
        --wallet-limit "${ZETTA_UNUSUAL_BETTING_WALLET_LIMIT:-100}" \
        --trade-limit "${ZETTA_UNUSUAL_BETTING_TRADE_LIMIT:-100}" \
        --large-threshold "${ZETTA_UNUSUAL_BETTING_LARGE_THRESHOLD:-500000}" \
        --very-large-threshold "${ZETTA_UNUSUAL_BETTING_VERY_LARGE_THRESHOLD:-1000000}" \
        --extreme-threshold "${ZETTA_UNUSUAL_BETTING_EXTREME_THRESHOLD:-5000000}" \
        --cold-price-threshold "${ZETTA_UNUSUAL_BETTING_COLD_PRICE_THRESHOLD:-0.25}" \
        "--${ZETTA_UNUSUAL_BETTING_INCLUDE_RELATED:-include-related-markets}" \
        --refresh-run "${ZETTA_UNUSUAL_BETTING_REFRESH_RUN:-unusual-betting}" \
        --trigger-reason "${ZETTA_UNUSUAL_BETTING_TRIGGER_REASON:-scheduled}" \
        --requeue-done
    ;;
  wallet-candidates)
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-wallets \
        --wallet-limit "${ZETTA_WALLET_CANDIDATE_REFRESH_LIMIT:-500}" \
        --since-hours "${ZETTA_WALLET_REFRESH_SINCE_HOURS:-48}" \
        --page-limit "${ZETTA_WALLET_REFRESH_PAGE_LIMIT:-500}" \
        --max-pages "${ZETTA_WALLET_REFRESH_MAX_PAGES:-2}" \
        --candidate-mode "${ZETTA_WALLET_CANDIDATE_MODE:-smart-candidates}" \
        --min-notional "${ZETTA_WALLET_CANDIDATE_MIN_NOTIONAL:-10000}" \
        --no-include-trades \
        --no-include-activity \
        --include-wallet-portfolio \
        --refresh-run "${ZETTA_WALLET_CANDIDATE_REFRESH_RUN:-wallet-candidates}" \
        --requeue-done
    ;;
  wallet-pnl-candidates)
    PNL_REFRESH_RUN="${ZETTA_WALLET_PNL_CANDIDATE_REFRESH_RUN:-wallet-pnl-candidates-$(date -u +%Y%m%d%H)}"
    PNL_REQUEUE_ARGS=()
    if [[ "${ZETTA_WALLET_PNL_CANDIDATE_REQUEUE_DONE:-0}" == "1" ]]; then
      PNL_REQUEUE_ARGS+=(--requeue-done)
    fi
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --task-store postgres \
      --node-id "$ZETTA_NODE_ID" \
      tasks seed-wallets \
        --wallet-limit "${ZETTA_WALLET_PNL_CANDIDATE_REFRESH_LIMIT:-5000}" \
        --since-hours "${ZETTA_WALLET_REFRESH_SINCE_HOURS:-48}" \
        --page-limit "${ZETTA_WALLET_REFRESH_PAGE_LIMIT:-500}" \
        --max-pages "${ZETTA_WALLET_REFRESH_MAX_PAGES:-2}" \
        --candidate-mode "${ZETTA_WALLET_PNL_CANDIDATE_MODE:-smart-candidates}" \
        --min-notional "${ZETTA_WALLET_PNL_CANDIDATE_MIN_NOTIONAL:-10000}" \
        --no-include-trades \
        --no-include-activity \
        --no-include-wallet-portfolio \
        --include-wallet-pnl \
        --refresh-run "$PNL_REFRESH_RUN" \
        "${PNL_REQUEUE_ARGS[@]}"
    ;;
  wallet-pnl-load)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-user-pnl \
      --batch-size "${ZETTA_WALLET_PNL_LOAD_BATCH_SIZE:-20000}"
    ;;
  load-trades-realtime)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load official-trade-feed-cache \
      --since-hours "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_SINCE_HOURS:-24}" \
      --batch-size "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_BATCH_SIZE:-10000}" \
      --wallet-scan-limit "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_WALLET_SCAN_LIMIT:-5000}" \
      --per-wallet-limit "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_PER_WALLET_LIMIT:-50}" \
      --recent-limit "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_RECENT_LIMIT:-5000}" \
      "--${ZETTA_OFFICIAL_TRADE_FEED_CACHE_STATE_DEDUPE:-state-dedupe}" \
      --loaded-key-limit "${ZETTA_OFFICIAL_TRADE_FEED_CACHE_LOADED_KEY_LIMIT:-500000}" \
      "--${ZETTA_OFFICIAL_TRADE_FEED_CACHE_FIFA_ONLY:-fifa-only}"
    TRADE_LOAD_ARGS=(
      "${COMMON_ARGS[@]}"
      load data-trades
      --batch-size "${ZETTA_REALTIME_TRADE_BATCH_SIZE:-1000}"
      --workers 1
      --max-paths "${ZETTA_REALTIME_TRADE_MAX_PATHS:-1000}"
    )
    if [[ "${ZETTA_REALTIME_TRADE_NEWEST_FIRST:-1}" == "1" ]]; then
      TRADE_LOAD_ARGS+=(--newest-first)
    fi
    "$ZETTA_PYTHON" -m zetta.cli "${TRADE_LOAD_ARGS[@]}"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-activity \
      --batch-size "${ZETTA_REALTIME_TRADE_BATCH_SIZE:-1000}"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-positions \
      --batch-size "${ZETTA_REALTIME_TRADE_BATCH_SIZE:-1000}"
    if [[ "${ZETTA_LOAD_WALLET_SNAPSHOTS:-1}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-wallet-portfolio \
        --batch-size "${ZETTA_REALTIME_TRADE_BATCH_SIZE:-1000}"
      "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-user-pnl \
        --batch-size "${ZETTA_REALTIME_TRADE_BATCH_SIZE:-1000}"
    else
      printf '{"loader":"wallet_snapshots","skipped":true,"reason":"disabled"}\n'
    fi
    ;;
  live-token-metadata)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" refresh live-token-metadata \
      --lookback-minutes "${ZETTA_LIVE_TOKEN_METADATA_LOOKBACK_MINUTES:-30}" \
      --limit "${ZETTA_LIVE_TOKEN_METADATA_LIMIT:-200}" \
      --min-notional "${ZETTA_LIVE_TOKEN_METADATA_MIN_NOTIONAL:-100}" \
      --sleep-seconds "${ZETTA_LIVE_TOKEN_METADATA_SLEEP_SECONDS:-0.05}" \
      --load-batch-size "${ZETTA_LIVE_TOKEN_METADATA_LOAD_BATCH_SIZE:-1000}"
    ;;
  polycop-wallet-signals)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" refresh polycop-wallet-signals \
      --page-size "${ZETTA_POLYCOP_WALLET_SIGNAL_PAGE_SIZE:-15}" \
      --max-pages "${ZETTA_POLYCOP_WALLET_SIGNAL_MAX_PAGES:-100}" \
      --sleep-seconds "${ZETTA_POLYCOP_WALLET_SIGNAL_SLEEP_SECONDS:-0.1}" \
      --timeout-seconds "${ZETTA_POLYCOP_WALLET_SIGNAL_TIMEOUT_SECONDS:-20}" \
      --limit "${ZETTA_POLYCOP_WALLET_SIGNAL_LIMIT:-2000}" \
      --trigger-reason "${ZETTA_POLYCOP_WALLET_SIGNAL_TRIGGER_REASON:-scheduled}"
    ;;
  wallet-rollup)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" build wallet-trade-rollup \
      --since-hours "${ZETTA_WALLET_ROLLUP_SINCE_HOURS:-48}"
    ;;
  wallet-screener)
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --timeout "${ZETTA_WALLET_SCREENER_TIMEOUT_SECONDS:-1800}" \
      build wallet-screener
    ;;
  wallet-fifa-24h-pnl)
    "$ZETTA_PYTHON" -m zetta.cli \
      "${COMMON_ARGS[@]}" \
      --timeout "${ZETTA_WALLET_FIFA_24H_PNL_TIMEOUT_SECONDS:-1800}" \
      build wallet-fifa-24h-pnl \
      --window-hours "${ZETTA_WALLET_FIFA_24H_PNL_WINDOW_HOURS:-24}"
    ;;
  chain-frontier)
    EXCHANGE_ARGS=()
    if [[ -n "${ZETTA_CHAIN_EXCHANGE_ADDRESSES:-}" ]]; then
      IFS=',' read -r -a CHAIN_EXCHANGE_ADDRESSES <<< "$ZETTA_CHAIN_EXCHANGE_ADDRESSES"
      for address in "${CHAIN_EXCHANGE_ADDRESSES[@]}"; do
        address="${address//[[:space:]]/}"
        if [[ -n "$address" ]]; then
          EXCHANGE_ARGS+=(--exchange-address "$address")
        fi
      done
    fi
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" chain frontier \
      --lookback-blocks "${ZETTA_CHAIN_FRONTIER_LOOKBACK_BLOCKS:-80}" \
      --confirmations "${ZETTA_CHAIN_FRONTIER_CONFIRMATIONS:-64}" \
      --overlap-blocks "${ZETTA_CHAIN_FRONTIER_OVERLAP_BLOCKS:-10}" \
      --step-blocks "${ZETTA_CHAIN_FRONTIER_STEP_BLOCKS:-80}" \
      --conditional-tokens-address "${ZETTA_CHAIN_CTF_ADDRESS:-0x4d97dcd97ec945f40cf65f87097ace5ea0476045}" \
      --batch-size "${ZETTA_CHAIN_FRONTIER_BATCH_SIZE:-2000}" \
      "${EXCHANGE_ARGS[@]}"
    ;;
  chain-pnl)
    if [[ "${ZETTA_BUILD_CHAIN_PNL:-1}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" build trader-chain-pnl
    else
      printf '{"mart":"trader_chain_pnl","skipped":true,"reason":"disabled"}\n'
    fi
    ;;
  load)
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load gamma-raw --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-trades \
      --batch-size "$ZETTA_LOADER_BATCH_SIZE" \
      --workers "${ZETTA_LOADER_WORKERS:-1}" \
      --max-paths "${ZETTA_LOADER_MAX_PATHS:-5000}"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-activity --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-holders --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-market-positions --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-positions --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    if [[ "${ZETTA_LOAD_WALLET_SNAPSHOTS:-1}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-wallet-portfolio --batch-size "$ZETTA_LOADER_BATCH_SIZE"
      "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-user-pnl --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    else
      printf '{"loader":"wallet_snapshots","skipped":true,"reason":"disabled"}\n'
    fi
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load data-open-interest --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load clob-price-history --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load clob-books --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load clob-ws-market-books --batch-size "$ZETTA_LOADER_BATCH_SIZE" --workers "${ZETTA_LOADER_WORKERS:-1}"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load chain-logs --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load exchange-fills --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load orders-matched --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load fees-charged --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load balance-movements --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    "$ZETTA_PYTHON" -m zetta.cli "${COMMON_ARGS[@]}" load lifecycle-events --batch-size "$ZETTA_LOADER_BATCH_SIZE"
    ;;
  marts)
    MART_ARGS=("${COMMON_ARGS[@]}" --timeout "${ZETTA_MART_TIMEOUT_SECONDS:-1800}")
    "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build market-1m
    if [[ "${ZETTA_MART_BUILD_TRADER_PROFILES:-0}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build trader-profiles
    else
      printf '{"mart":"trader_profile","skipped":true,"reason":"disabled_for_regular_marts"}\n'
    fi
    if [[ "${ZETTA_BUILD_CHAIN_PNL:-1}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build trader-chain-pnl
    else
      printf '{"mart":"trader_chain_pnl","skipped":true,"reason":"disabled"}\n'
    fi
    if [[ "${ZETTA_MART_BUILD_WALLET_SCREENER:-0}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build wallet-screener
    else
      printf '{"mart":"wallet_screener","skipped":true,"reason":"disabled_for_regular_marts"}\n'
    fi
    if [[ "${ZETTA_MART_BUILD_TRADE_RECONCILIATION:-0}" == "1" ]]; then
      "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build trade-reconciliation
    else
      printf '{"mart":"trade_reconciliation","skipped":true,"reason":"disabled_for_regular_marts"}\n'
    fi
    "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build settlement-audit
    "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build alerts --since-hours 24
    "$ZETTA_PYTHON" -m zetta.cli "${MART_ARGS[@]}" build collector-health
    ;;
  *)
    echo "unknown mode: $MODE" >&2
    exit 2
    ;;
esac
