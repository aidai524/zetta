[Unit]
Description=Zetta FIFA wallet 24h PnL mart
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/zetta/zetta.env
ExecStart=/usr/local/bin/zetta-runner wallet-fifa-24h-pnl
MemoryAccounting=true
MemoryMax=12G
TasksMax=64
TimeoutStartSec=30min
