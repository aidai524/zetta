ZETTA_PUBLISH_SOURCE_DIR=/root/zetta
ZETTA_PYTHON=/opt/zetta/.venv/bin/python
ZETTA_PUBLISH_DATA_DIR=/var/lib/zetta/publish
ZETTA_PUBLISH_SYNC_TARGET=zetta@prod-zetta.prophet.zone:/var/lib/zetta/publish/
ZETTA_PUBLISH_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"
ZETTA_PUBLISH_SYNC_LOCK_FILE=/run/zetta-publish-sync.lock
