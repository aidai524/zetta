[Unit]
Description=Zetta unusual betting signal task seeder
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/zetta/zetta.env
ExecStart=/usr/local/bin/zetta-runner unusual-betting
MemoryAccounting=true
MemoryMax=512M
TasksMax=64
TimeoutStartSec=2min
