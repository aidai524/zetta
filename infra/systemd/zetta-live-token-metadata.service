[Unit]
Description=Zetta live token metadata refresher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/zetta/zetta.env
ExecStart=/usr/local/bin/zetta-runner live-token-metadata
MemoryAccounting=true
MemoryMax=2G
TasksMax=64
TimeoutStartSec=3min
